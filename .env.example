# Development points at the local Supabase stack (`npx supabase start` prints
# these values). Production credentials live in Vercel only.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=

# Production only. CRON_SECRET is the bearer token the appointment-reminder
# cron presents.
# CRON_SECRET=

# E2E tests (required by `npm run test:e2e` and `npm run setup:test-data`).
# Must be a SEPARATE database — the tests create shops, tickets and payments.
# The local stack is the easy answer; see e2e/README.md.
E2E_SUPABASE_URL=http://127.0.0.1:54321
E2E_SUPABASE_ANON_KEY=
E2E_SUPABASE_SERVICE_ROLE_KEY=
E2E_SESSION_SECRET=e2e-only-session-secret
# The PIN of the seeded staff row. Not committed: set it with
#   STAFF_PIN=1234 npm run set-pin -- --role owner
E2E_STAFF_PIN=

# Sentry (optional - for error monitoring)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
