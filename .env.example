# Development points at the local Supabase stack (`npx supabase start` prints
# these values). Production credentials live in Vercel only.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
SESSION_SECRET=

# Production only. SITE_ACCESS_TOKEN guards the site: the first visit needs
# /?k=<token>, and a production build without it serves 404 to everything, so
# it is required there. Outside production a missing token leaves the gate open,
# which is what development and the E2E defaults rely on. CRON_SECRET is the
# bearer token the appointment-reminder cron presents.
# SITE_ACCESS_TOKEN=
# CRON_SECRET=

# E2E tests (required by `npm run test:e2e` and `npm run setup:test-data`).
# Must be a SEPARATE database — the tests create shops, tickets and payments.
# The local stack is the easy answer; see e2e/README.md.
E2E_SUPABASE_URL=http://127.0.0.1:54321
E2E_SUPABASE_ANON_KEY=
E2E_SUPABASE_SERVICE_ROLE_KEY=
E2E_SESSION_SECRET=e2e-only-session-secret

# Sentry (optional - for error monitoring)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
